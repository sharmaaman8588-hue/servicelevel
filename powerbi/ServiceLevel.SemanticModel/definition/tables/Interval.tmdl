	partition Interval = m
		mode: import
		source =
				let
					Source = Csv.Document(File.Contents(DataFolder & "\Interval.csv"), [Delimiter=",", Columns=16, Encoding=65001, QuoteStyle=QuoteStyle.None]),
					Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
					Typed = Table.TransformColumnTypes(Promoted, {{"queue", type text}, {"interval_start", type datetime}, {"date", type date}, {"interval_idx", Int64.Type}, {"offered", Int64.Type}, {"answered", Int64.Type}, {"answered_within_t", Int64.Type}, {"abandoned", Int64.Type}, {"abandoned_within_t", Int64.Type}, {"handle_seconds", Int64.Type}, {"wait_seconds", Int64.Type}, {"rostered", Int64.Type}, {"logged_in", Int64.Type}, {"required_agents", Int64.Type}, {"staffing_gap", Int64.Type}, {"sl1_pct", type number}}, "en-US")
				in
					Typed

	annotation PBI_ResultType = Table
