table Interval
	lineageTag: ad657979-20c0-5400-ad2f-a49240027691

	/// Answered within threshold / offered.
	measure 'SL1 %' = DIVIDE(SUM(Interval[answered_within_t]), SUM(Interval[offered]))
		formatString: 0.0%
		lineageTag: 9cd689be-efda-5157-ac56-d48d3ca9a019

	/// Answered within threshold / answered. Abandoned calls are ignored.
	measure 'SL2 %' = DIVIDE(SUM(Interval[answered_within_t]), SUM(Interval[answered]))
		formatString: 0.0%
		lineageTag: fe860ff9-c49d-523e-a3a0-aadbaf6d5e0c

	/// Answered within threshold / (offered - abandoned within threshold).
	measure 'SL3 %' = DIVIDE(SUM(Interval[answered_within_t]), SUM(Interval[offered]) - SUM(Interval[abandoned_within_t]))
		formatString: 0.0%
		lineageTag: c341c747-2fbf-5bf2-ac22-3adb9f97493e

	/// (Answered + abandoned within threshold) / offered.
	measure 'SL4 %' = DIVIDE(SUM(Interval[answered_within_t]) + SUM(Interval[abandoned_within_t]), SUM(Interval[offered]))
		formatString: 0.0%
		lineageTag: 353df1c6-fc60-5f56-835b-e61362a63e81

	/// Abandoned / offered.
	measure 'Abandon %' = DIVIDE(SUM(Interval[abandoned]), SUM(Interval[offered]))
		formatString: 0.0%
		lineageTag: 51f914ee-15d4-5de7-9d95-23d7ff498905

	/// Average speed of answer: queue seconds of answered calls / answered.
	measure 'ASA (s)' = DIVIDE(SUM(Interval[wait_seconds]), SUM(Interval[answered]))
		formatString: 0.0
		lineageTag: ead9228e-f4ff-57ef-8223-d6d5a9cdcc56

	/// Handle seconds / logged-in agent seconds.
	measure 'Occupancy %' = DIVIDE(SUM(Interval[handle_seconds]), SUM(Interval[logged_in]) * 1800)
		formatString: 0.0%
		lineageTag: b4aa713a-9dcb-51f0-b21a-465b3d0e5eb3

	/// Erlang C requirement at the actual offered calls, per interval.
	measure 'Required Agents' = DIVIDE(SUM(Interval[required_agents]), DISTINCTCOUNT(Interval[interval_start]))
		formatString: 0.0
		lineageTag: 8df345e0-37a0-53ae-9615-2d622e57496c

	/// Agents logged in, per interval.
	measure 'Logged-in Agents' = DIVIDE(SUM(Interval[logged_in]), DISTINCTCOUNT(Interval[interval_start]))
		formatString: 0.0
		lineageTag: 9029f48c-3ca7-5bed-87ad-c525f0360f55

	/// Required minus logged-in agents; positive means short-staffed.
	measure 'Staffing Gap' = [Required Agents] - [Logged-in Agents]
		formatString: 0.0;-0.0;0.0
		lineageTag: 1c415bd5-1b94-5e32-ac64-fa7ecddbf68b

