	partition TimeOfDay = m
		mode: import
		source =
				let
					Source = Csv.Document(File.Contents(DataFolder & "\TimeOfDay.csv"), [Delimiter=",", Columns=4, Encoding=65001, QuoteStyle=QuoteStyle.None]),
					Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
					Typed = Table.TransformColumnTypes(Promoted, {{"interval_idx", Int64.Type}, {"time_label", type text}, {"hour", Int64.Type}, {"daypart", type text}}, "en-US")
